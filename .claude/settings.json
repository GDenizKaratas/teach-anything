{
  "permissions": {
    "allow": [
      "Bash(tools/learn:*)",
      "Bash(./tools/learn:*)",
      "Bash(tools/doctor:*)",
      "Bash(./tools/doctor:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python:*)",
      "Bash(uv sync:*)",
      "Edit(./tracks/**)",
      "Edit(./learner/**)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/learn status" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/py \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect_learner_work.py" }
        ]
      }
    ]
  }
}
