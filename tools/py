#!/bin/sh
# Runs Python whichever way is available: uv-managed first, then system python3.
if command -v uv >/dev/null 2>&1; then exec uv run --no-project --quiet python "$@"; fi
if [ -x "$HOME/.local/bin/uv" ]; then exec "$HOME/.local/bin/uv" run --no-project --quiet python "$@"; fi
if command -v python3 >/dev/null 2>&1; then exec python3 "$@"; fi
echo "Python bulunamadı / Python not found. Claude'a 'kurulum yapalım' yaz." >&2
exit 1
