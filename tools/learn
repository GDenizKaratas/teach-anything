#!/bin/sh
here="$(cd "$(dirname "$0")" && pwd)"
"$here/py" "$here/learn.py" "$@"
code=$?
if [ "$code" = 127 ]; then
  # Printed to stdout so it reaches Claude's context at session start.
  echo "LEARNING ENGINE UNAVAILABLE: Python not found. Run the setup skill FIRST (install uv, then uv sync) before onboarding or teaching."
fi
exit $code
